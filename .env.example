##########################################
# Feegow
##########################################

FEEGOW_BASE_URL=https://api.feegow.com/v1/api
FEEGOW_ACCESS_TOKEN=SEU_TOKEN

##########################################
# Cal.com
##########################################

CALCOM_WEBHOOK_SECRET=SEU_SEGREDO
CAL_FEEGOW_DB_PATH=/opt/data/workspace/hermes-feegow-mcp/data/cal_feegow_sync.db

##########################################
# PagBank Sandbox
##########################################

PAGBANK_ENV=sandbox
PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_TOKEN=SEU_TOKEN_SANDBOX
PAGBANK_DEFAULT_AMOUNT=100
PAGBANK_WEBHOOK_URL=https://integracao.magnoliasdm.com.br/webhooks/pagbank
PUBLIC_BASE_URL=https://integracao.magnoliasdm.com.br

##########################################
# MCP
##########################################

MCP_NAME=ANA

##########################################
# Python
##########################################

PYTHONUNBUFFERED=1

##########################################
# Ambiente
##########################################

# Mude para 'production' junto com PAGBANK_ENV/PAGBANK_BASE_URL quando for para produção de verdade.
ENVIRONMENT=development

##########################################
# Logging
##########################################

LOG_LEVEL=INFO
